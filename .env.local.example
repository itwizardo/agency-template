# ===========================================
# WHMCS Integration (Optional)
# ===========================================
# Get API credentials from WHMCS Admin > Setup > Staff Management > API Credentials
# Required permissions: GetTLDPricing, GetProducts, DomainWhois, GetClientsDetails,
#                       GetClients, GetClientsProducts, GetInvoices, GetTickets, OpenTicket

WHMCS_URL=https://billing.yourdomain.com
WHMCS_API_IDENTIFIER=your_api_identifier
WHMCS_API_SECRET=your_api_secret

# ===========================================
# Telegram Notifications (Optional)
# ===========================================
# Create a bot via @BotFather on Telegram
# Get chat ID by messaging @userinfobot

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Optional: For group topics/forums
TELEGRAM_TOPIC_ID=

# ===========================================
# Email (Optional - Alternative to Telegram)
# ===========================================
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx
